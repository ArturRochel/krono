# ==========================================
# 1. BANCO DE DADOS (PostgreSQL 16 + pgvector)
# ==========================================
POSTGRES_USER=krono_user
POSTGRES_PASSWORD=troque_esta_senha_em_producao
POSTGRES_DB=krono_db
POSTGRES_PORT=5432

# ==========================================
# 2. BACKEND (FastAPI + SQLAlchemy 2.0)
# ==========================================
# Em Docker Compose, o host do banco é o nome do serviço ('db')
DATABASE_URL=postgresql+psycopg://krono_user:troque_esta_senha_em_producao@db:5432/krono_db
BACKEND_PORT=8000
TZ=America/Fortaleza

# ==========================================
# 3. FRONTEND (React + Vite)
# ==========================================
# Local: http://localhost:8000 | Produção (VPS): https://api.seudominio.me
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173

# ==========================================
# 4. FUTURAS INTEGRAÇÕES (Fases 3 e 4 - Opcional)
